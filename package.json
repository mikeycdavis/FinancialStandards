{
  "name": "financial-standards",
  "version": "0.1.0",
  "description": "Numbered financial analysis and decision standards, and the commands that check an analysis against them.",
  "type": "module",
  "bin": {
    "standards": "scripts/standards.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
